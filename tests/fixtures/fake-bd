#!/usr/bin/env python3
"""Beads CLI contract fixture. Never opens a database or a network connection."""
import json
import os
import sys
import time

args = sys.argv[1:]
assert args[:2] == ["--readonly", "--json"], args
assert args[2] in ("list", "show"), args
mode = os.environ.get("RATA_TEST_BD_MODE", "ok")
if mode == "slow":
    time.sleep(10)
if mode == "error":
    print("database unavailable", file=sys.stderr)
    sys.exit(1)
if mode == "invalid":
    print("not JSON")
else:
    print(json.dumps([{
        "id": "test-1", "title": "A task", "status": "open",
        "priority": 1, "issue_type": "task", "description": "Task details"
    }]))
