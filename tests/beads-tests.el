;;; -*- lexical-binding: t; -*-
;;; beads-tests.el --- Beads rendering and CLI lifecycle tests

(require 'ert)
(require 'cl-lib)
(require 'rata-beads)

(defconst rata-test-beads--cli
  (expand-file-name "fixtures/fake-bd" (file-name-directory load-file-name)))

(defun rata-test-beads--wait ()
  "Wait for the current Beads query, with a test deadline."
  (let ((deadline (+ (float-time) 4)))
    (while (and rata-beads--process (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (should-not rata-beads--process)))

(ert-deftest rata-test-beads-cli-arguments ()
  (with-temp-buffer
    (rata-beads-mode)
    (should (equal (rata-beads--arguments)
                   '("--readonly" "--json" "list" "--limit" "0")))
    (setq rata-beads--view "ready")
    (should (member "--ready" (rata-beads--arguments)))
    (setq rata-beads--view "closed")
    (should (equal (last (rata-beads--arguments) 2) '("--status" "closed")))
    (setq rata-beads--view "all")
    (should (member "--all" (rata-beads--arguments)))
    (setq rata-beads--id "--strange-id")
    (should (equal (rata-beads--arguments)
                   '("--readonly" "--json" "show" "--id=--strange-id")))))

(ert-deftest rata-test-beads-json-validation ()
  (should-not (rata-beads--parse "[]"))
  (dolist (text '("null" "{}" "[{}]" "oops" "[{\"id\":4,\"title\":\"bad\"}]"))
    (should-error (rata-beads--parse text))))

(ert-deftest rata-test-beads-render-single-rows-and-details ()
  (with-temp-buffer
    (rata-beads-mode)
    (let* ((issue '((id . "t-1") (title . "First\nline") (status . "open")
                    (priority . 0) (issue_type . "bug")
                    (description . "Description\nMore text")))
           (issues (list issue '((id . "t-2") (title . "Second")
                                 (status . "closed") (priority . 3)
                                 (issue_type . "task")))))
      (rata-beads--render issues)
      ;; Redisplay fontifies the buffer and removes ordinary `face' properties.
      ;; Check the colors after that pass, not just immediately after insertion.
      (font-lock-ensure)
      (should truncate-lines)
      (should-not (string-match-p "Description" (buffer-string)))
      (goto-char (point-min))
      (re-search-forward "^ID +Status +Pri +Type +Title$")
      (forward-line 1)
      (should (looking-at "t-1 +open +P0 +bug +First line$"))
      (should (equal (rata-beads--current-id) "t-1"))
      (should-not (get-text-property (point) 'font-lock-face))
      (search-forward "open")
      (should (eq (get-text-property (1- (point)) 'font-lock-face)
                  'rata-beads-status-open))
      (search-forward "P0")
      (should (eq (get-text-property (1- (point)) 'font-lock-face)
                  'rata-beads-priority-0))
      (search-forward "First line")
      (should-not (get-text-property (1- (point)) 'font-lock-face))
      (forward-line 1)
      (should (looking-at "t-2 +closed +P3 +task +Second$"))
      (should (equal (rata-beads--current-id) "t-2"))
      (search-forward "closed")
      (should (eq (get-text-property (1- (point)) 'font-lock-face)
                  'rata-beads-status-closed))
      (search-forward "P3")
      (should (eq (get-text-property (1- (point)) 'font-lock-face)
                  'rata-beads-priority-3))
      (forward-line 1)
      (should (eobp))
      (setq rata-beads--id "t-1")
      (rata-beads--render (list issue))
      (font-lock-ensure)
      (goto-char (point-min))
      (search-forward "Status: open")
      (should (eq (get-text-property (1- (point)) 'font-lock-face)
                  'rata-beads-status-open))
      (search-forward "Pri: P0")
      (should (eq (get-text-property (1- (point)) 'font-lock-face)
                  'rata-beads-priority-0))
      (goto-char (point-min))
      (search-forward "Description")
      (should-not (invisible-p (1- (point))))
      (rata-beads--render nil)
      (should (string-match-p "No tasks" (buffer-string))))))

(ert-deftest rata-test-beads-epic-groups ()
  "Interleaved priorities stay under their epic; headings fold just that group."
  (with-temp-buffer
    (rata-beads-mode)
    (rata-beads--render
     '(((id . "child-b") (title . "B child") (priority . 0) (parent . "epic-b"))
       ((id . "child-a-low") (title . "A low") (priority . 3) (parent . "epic-a"))
       ((id . "epic-b") (title . "Second epic") (priority . 2) (issue_type . "epic"))
       ((id . "unrelated.1") (title . "Standalone") (priority . 0))
       ((id . "child-a") (title . "A child") (priority . 1)
        (dependencies . (((type . "blocks") (depends_on_id . "epic-b"))
                         ((type . "parent-child") (depends_on_id . "epic-a")))))
       ((id . "grandchild") (title . "A grandchild") (priority . 2)
        (parent . "child-a"))
       ((id . "epic-a") (title . "First\nepic") (priority . 1) (issue_type . "epic"))))
    (goto-char (point-min))
    (search-forward "── Epic: epic-a — First epic ──")
    (let ((group (magit-current-section)))
      (should (eq (oref group type) 'rata-beads-group))
      (forward-line 1)
      (should (equal (rata-beads--current-id) "epic-a"))
      (let ((row (point)))
        (dolist (id '("epic-a" "child-a" "grandchild" "child-a-low"))
          (should (equal (rata-beads--current-id) id))
          (forward-line 1))
        (magit-section-toggle group)
        (should (invisible-p row))
        (magit-section-toggle group)
        (should-not (invisible-p row))))
    (search-forward "── Epic: epic-b — Second epic ──")
    (forward-line 1)
    (should (equal (rata-beads--current-id) "epic-b"))
    (forward-line 1)
    (should (equal (rata-beads--current-id) "child-b"))
    (should-not (invisible-p (point)))
    (search-forward "── Other tasks ──")
    (forward-line 1)
    (should (equal (rata-beads--current-id) "unrelated.1"))))

(ert-deftest rata-test-beads-filtered-parents-and-cycles ()
  "Missing parents remain identifiable without injecting tasks into a view."
  (with-temp-buffer
    (rata-beads-mode)
    (setq rata-beads--view "ready")
    (rata-beads--render
     '(((id . "child") (title . "Ready child") (parent . "missing"))
       ((id . "other") (title . "Another child") (parent . "missing"))
       ((id . "cycle-a") (title . "Cycle A") (parent . "cycle-b"))
       ((id . "cycle-b") (title . "Cycle B") (parent . "cycle-a"))))
    (goto-char (point-min))
    (search-forward "Parent: missing (outside this view)")
    (forward-line 1)
    (should (equal (rata-beads--current-id) "child"))
    (forward-line 1)
    (should (equal (rata-beads--current-id) "other"))
    (should-not (search-forward "Parent: missing" nil t))
    (search-forward "Other tasks")
    (forward-line 1)
    (should (equal (rata-beads--current-id) "cycle-a"))
    (forward-line 1)
    (should (equal (rata-beads--current-id) "cycle-b"))))

(ert-deftest rata-test-beads-details-reuse-side-window ()
  "Details take focus, reuse one window, and close with their dashboard."
  (let* ((source (generate-new-buffer " *beads-side-test*"))
         (directory (concat temporary-file-directory (buffer-name source) "/"))
         (detail-name (format "*Beads details: %s*" directory))
         queried)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (rata-beads-mode)
          (setq default-directory directory)
          (rata-beads--render '(((id . "t-1") (title . "First") (priority . 0))
                                ((id . "t-2") (title . "Second") (priority . 1))))
          (goto-char (point-min))
          (search-forward "t-1")
          (let ((list-window (selected-window)))
            (cl-letf (((symbol-function 'rata-beads-refresh)
                       (lambda ()
                         (push rata-beads--id queried)
                         (rata-beads--render
                          (list (list (cons 'id rata-beads--id)
                                      '(title . "Detail title")
                                      (cons 'description
                                            (concat "Text of " rata-beads--id))))))))
              (rata-beads-show)
              (let* ((detail (get-buffer detail-name))
                     (side (get-buffer-window detail)))
                (should (window-live-p side))
                (should (eq (window-parameter side 'window-side) 'right))
                (should (eq (selected-window) side))
                (should (eq (window-buffer list-window) source))
                (with-current-buffer detail
                  (should-not truncate-lines)
                  (should (string-match-p "Text of t-1" (buffer-string))))
                (select-window list-window)
                (search-forward "t-2")
                (rata-beads-show)
                (should (eq (get-buffer-window detail) side))
                (should (equal queried '("t-2" "t-1")))
                (with-current-buffer detail
                  (should (string-match-p "Text of t-2" (buffer-string)))
                  (should-not (string-match-p "Text of t-1" (buffer-string))))
                (should (eq (selected-window) side))
                ;; Quitting just the task returns to the still-open list.
                (rata-beads-quit)
                (should-not (get-buffer-window detail))
                (should (eq (selected-window) list-window))
                (should (eq (window-buffer list-window) source))
                (rata-beads-show)
                (should (get-buffer-window detail))
                ;; Quitting the dashboard closes its reopened task window too.
                (select-window list-window)
                (rata-beads-quit)
                (should-not (get-buffer-window detail))
                (should-not (get-buffer-window source))))))
      (when-let* ((detail (get-buffer detail-name))) (kill-buffer detail))
      (kill-buffer source))))

(ert-deftest rata-test-beads-async-success-failures-and-timeout ()
  (let ((rata-beads-executable rata-test-beads--cli)
        (rata-beads-timeout 2)
        (process-environment (copy-sequence process-environment)))
    (with-temp-buffer
      (rata-beads-mode)
      (rata-beads-refresh)
      (rata-test-beads--wait)
      (should (string-match-p "A task" (buffer-string)))
      (let ((previous (buffer-string)))
        (dolist (mode '("error" "invalid" "slow"))
          (when (equal mode "slow") (setq rata-beads-timeout 0.05))
          (setenv "RATA_TEST_BD_MODE" mode)
          (rata-beads-refresh)
          (rata-test-beads--wait)
          (should (equal previous (buffer-string)))
          (should (string-match-p "failed" mode-line-process)))))))

(ert-deftest rata-test-beads-refresh-invalidates-old-query ()
  (let ((rata-beads-executable rata-test-beads--cli)
        (process-environment (copy-sequence process-environment)))
    (with-temp-buffer
      (rata-beads-mode)
      (setenv "RATA_TEST_BD_MODE" "slow")
      (rata-beads-refresh)
      (let ((old rata-beads--process))
        (setenv "RATA_TEST_BD_MODE" "ok")
        (rata-beads-refresh)
        (rata-test-beads--wait)
        (should-not (process-live-p old))
        (should (string-match-p "A task" (buffer-string)))))))

(ert-deftest rata-test-beads-buffer-kill-cancels-query ()
  (let ((rata-beads-executable rata-test-beads--cli)
        (process-environment (copy-sequence process-environment))
        process)
    (setenv "RATA_TEST_BD_MODE" "slow")
    (let ((buffer (generate-new-buffer " *beads-kill-test*")))
      (unwind-protect
          (with-current-buffer buffer
            (rata-beads-mode)
            (rata-beads-refresh)
            (setq process rata-beads--process))
        (kill-buffer buffer)))
    (accept-process-output nil 0.05)
    (should-not (process-live-p process))))

(ert-deftest rata-test-beads-missing-cli ()
  (let ((rata-beads-executable "/nonexistent/bd"))
    (with-temp-buffer
      (rata-beads-mode)
      (should-error (rata-beads-refresh) :type 'user-error))))

(ert-deftest rata-test-beads-evil-bindings ()
  (when (featurep 'evil)
    (with-temp-buffer
      (rata-beads-mode)
      (evil-local-mode 1)
      (evil-normal-state)
      (should (eq (key-binding (kbd "RET")) #'rata-beads-show))
      (should (eq (key-binding [mouse-1]) #'rata-beads-mouse-show))
      (should (eq (key-binding (kbd "q")) #'rata-beads-quit))
      (should (eq (key-binding (kbd "TAB")) #'magit-section-toggle))
      (should (eq (key-binding (kbd "gr")) #'rata-beads-refresh)))))

(provide 'beads-tests)
