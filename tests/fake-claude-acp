#!/usr/bin/env python3
"""A scripted stand-in for claude-agent-acp, for tests/claude-loop-acp-e2e.el.

Speaks just enough ACP (newline-delimited JSON-RPC 2.0 over stdio) for
agent-shell to start a session and run prompts.  No network, no model.

FAKE_ACP_SCRIPT  path to a JSON list with one object per prompt turn:
    text     agent message text for the turn (default "ok")
    tools    list of {"title", "kind", "command", "permission"}: each is
             reported as a tool call; with "permission" true the agent asks
             the client first and the tool fails unless an allow option was
             chosen
    cost     cumulative session cost reported after the turn, in USD
    stop     the stopReason (default "end_turn")
    hang     true: never answer the prompt until session/cancel arrives
    error    true: answer the prompt with a JSON-RPC error
    exit     true: exit the process mid-turn, without answering
FAKE_ACP_LOG     path; every message received is appended as one JSON line
"""
import json
import os
import sys
import threading

SCRIPT = json.load(open(os.environ["FAKE_ACP_SCRIPT"])) if os.environ.get("FAKE_ACP_SCRIPT") else []
LOG = os.environ.get("FAKE_ACP_LOG")
lock = threading.Lock()
pending = {}          # our request id -> threading.Event + response slot
cancelled = threading.Event()
turn = 0
next_id = 1000


def log(message):
    if LOG:
        with open(LOG, "a") as f:
            f.write(json.dumps(message) + "\n")


def send(message):
    with lock:
        sys.stdout.write(json.dumps(message) + "\n")
        sys.stdout.flush()


def notify(session, update):
    send({"jsonrpc": "2.0", "method": "session/update",
          "params": {"sessionId": session, "update": update}})


def ask(method, params):
    global next_id
    with lock:
        next_id += 1
        rid = next_id
    slot = {"event": threading.Event(), "response": None}
    pending[rid] = slot
    send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
    while not slot["event"].wait(0.05):
        if cancelled.is_set():
            return None
    return slot["response"]


def run_prompt(rid, params):
    global turn
    session = params.get("sessionId")
    step = SCRIPT[turn] if turn < len(SCRIPT) else {}
    turn += 1
    if step.get("exit"):
        os._exit(3)
    if step.get("error"):
        send({"jsonrpc": "2.0", "id": rid,
              "error": {"code": -32603, "message": "scripted failure"}})
        return
    for i, tool in enumerate(step.get("tools", [])):
        tid = "tool-%d-%d" % (turn, i)
        call = {"toolCallId": tid, "title": tool.get("title", tool.get("command", "tool")),
                "kind": tool.get("kind", "execute"), "status": "pending",
                "rawInput": {"command": tool.get("command", "")}}
        notify(session, dict(call, sessionUpdate="tool_call"))
        status = "completed"
        if tool.get("permission"):
            response = ask("session/request_permission", {
                "sessionId": session,
                "toolCall": call,
                "options": [
                    {"optionId": "allow", "name": "Allow", "kind": "allow_once"},
                    {"optionId": "reject", "name": "Reject", "kind": "reject_once"},
                    {"optionId": "always", "name": "Always allow", "kind": "allow_always"},
                ]})
            outcome = ((response or {}).get("result") or {}).get("outcome") or {}
            if outcome.get("optionId") not in ("allow", "always"):
                status = "failed"
        notify(session, {"sessionUpdate": "tool_call_update", "toolCallId": tid,
                         "status": status})
    notify(session, {"sessionUpdate": "agent_message_chunk",
                     "content": {"type": "text", "text": step.get("text", "ok")}})
    if "cost" in step:
        notify(session, {"sessionUpdate": "usage_update", "used": 1000, "size": 200000,
                         "cost": {"amount": step["cost"], "currency": "USD"}})
    if step.get("hang"):
        while not cancelled.wait(0.05):
            pass
        stop = "cancelled"
    else:
        stop = step.get("stop", "end_turn")
    send({"jsonrpc": "2.0", "id": rid,
          "result": {"stopReason": stop,
                     "usage": {"inputTokens": 1, "outputTokens": 1, "totalTokens": 2}}})


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        message = json.loads(line)
        log(message)
        method = message.get("method")
        rid = message.get("id")
        if method is None:                      # a response to one of our requests
            slot = pending.pop(rid, None)
            if slot:
                slot["response"] = message
                slot["event"].set()
            continue
        if method == "initialize":
            result = {"protocolVersion": 1,
                      "agentCapabilities": {"loadSession": False,
                                            "promptCapabilities": {}},
                      "authMethods": []}
        elif method == "session/new":
            result = {"sessionId": "fake-acp-session",
                      "modes": {"currentModeId": "default",
                                "availableModes": [
                                    {"id": "default", "name": "Default"},
                                    {"id": "acceptEdits", "name": "Accept Edits"}]}}
        elif method == "session/prompt":
            cancelled.clear()
            threading.Thread(target=run_prompt, args=(rid, message["params"]),
                             daemon=True).start()
            continue
        elif method == "session/cancel":
            cancelled.set()
            continue
        elif rid is None:                       # any other notification
            continue
        else:
            result = {}
        send({"jsonrpc": "2.0", "id": rid, "result": result})


main()
