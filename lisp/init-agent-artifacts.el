;;; init-agent-artifacts.el --- Antigravity artifact and plan management -*- lexical-binding: t; -*-

;; Open and approve artifacts generated by Google Antigravity in agent-shell.
;;
;; Antigravity writes session artifacts (implementation plans, walkthroughs,
;; design documents, reports) to ~/.gemini/antigravity-cli/brain/<session-id>/.
;; This module provides:
;;
;; 1. The `/artifact' slash command in Antigravity agent-shell buffers:
;;    intercepts locally to open the session artifact in a buffer (pop-to-buffer).
;;    - If exactly one artifact exists, opens it directly.
;;    - If multiple artifacts exist, prompts via completing-read with rich
;;      metadata annotations (summary, timestamp).
;;    - If a query argument is passed (`/artifact plan'), matches against
;;      artifact names and summaries.
;;
;; 2. The `/approve' slash command in Antigravity agent-shell buffers:
;;    finds the session's implementation plan and sends `[Approved] <plan>.md'
;;    to the agent shell.
;;
;; 3. Plan approval directly from the opened plan buffer:
;;    `rata-agent-antigravity-artifact-mode' activates in plan buffers,
;;    binding `C-c C-c' and Evil `, a' to approve the plan and submit to the shell.
;;
;; 4. Slash command autocompletion:
;;    typing `/' or `/art' in an Antigravity shell offers `/artifact' and `/approve'.
;;
;; 5. Evil / leader keybindings:
;;    `, A' in agent-shell to open artifacts, `SPC a i s A' globally,
;;    and `SPC a i s P' to approve plans.

;;; Code:

(require 'cl-lib)
(require 'subr-x)
(require 'map)
(require 'comint)
(require 'ring)

(eval-when-compile
  (defvar agent-shell--state)
  (defvar agent-shell-completion--shell-buffer)
  (defvar shell-maker--config)
  (defvar shell-maker--busy))

(declare-function agent-shell--shell-buffer "agent-shell")
(declare-function agent-shell-buffers "agent-shell")
(declare-function agent-shell--insert-to-shell-buffer "agent-shell")
(declare-function agent-shell--prompt-queue-enqueue "agent-shell-prompt-queue")
(declare-function shell-maker-busy "shell-maker")
(declare-function shell-maker-write-output "shell-maker")
(declare-function shell-maker-finish-output "shell-maker")
(declare-function evil-define-key* "evil-core")

(defgroup rata-agent-artifacts nil
  "Antigravity artifact management for agent-shell."
  :group 'agent-shell)

(defcustom rata-agent-antigravity-brain-dirs
  (list (expand-file-name "~/.gemini/antigravity-acp/brain")
        (expand-file-name "~/.gemini/antigravity-cli/brain")
        (expand-file-name "~/.gemini/antigravity/brain"))
  "Candidate directories to search for Antigravity conversation brain folders.
The first existing directory in the list is used as default when creating
new session artifact folders."
  :type '(repeat directory)
  :group 'rata-agent-artifacts)

(defcustom rata-agent-antigravity-brain-dir
  (expand-file-name "~/.gemini/antigravity-acp/brain")
  "Primary directory containing Antigravity conversation brain folders."
  :type 'directory
  :group 'rata-agent-artifacts)

(defcustom rata-agent-antigravity-system-prompt
  "<artifacts>\nArtifacts are special markdown (.md) documents that you can create to present structured information to the user.\nWhen asked to create an implementation plan, design document, or extensive report, you MUST write it as a markdown (.md) file to the session artifact directory under the session's brain folder.\nAlong with each artifact, write a companion metadata file `<filename>.md.metadata.json` containing JSON with keys `\"summary\"`, `\"requestFeedback\"` (set to true for plans awaiting approval), and `\"userFacing\": true`.\nKeep your chat responses concise: summarize your findings, state the artifact filename created, and let the user view and approve the artifact in Emacs.\n</artifacts>"
  "System prompt appended to Antigravity sessions in agent-shell."
  :type 'string
  :group 'rata-agent-artifacts)

(defvar-local rata-agent-antigravity-artifact-shell-buffer nil
  "The `agent-shell' buffer associated with this artifact buffer.")

(defvar rata-agent-antigravity-artifact-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "C-c C-c") #'rata-agent-antigravity-approve-plan)
    (define-key map (kbd "C-c C-k") #'rata-agent-antigravity-decline-plan)
    map)
  "Keymap for `rata-agent-antigravity-artifact-mode'.")

(define-minor-mode rata-agent-antigravity-artifact-mode
  "Minor mode enabled in Antigravity plan artifact buffers.
Provides convenient keybindings to approve or decline the plan
and submit feedback to the associated Antigravity `agent-shell' session."
  :lighter " [Plan]"
  :keymap rata-agent-antigravity-artifact-mode-map
  (if rata-agent-antigravity-artifact-mode
      (setq-local header-line-format
                  (propertize "  Plan Artifact  |  [C-c C-c] Approve  |  [C-c C-k] Decline  "
                              'face '(:inherit highlight :weight bold)))
    (kill-local-variable 'header-line-format)))

(with-eval-after-load 'evil
  (when (fboundp 'evil-define-key*)
    (evil-define-key* 'normal rata-agent-antigravity-artifact-mode-map
      (kbd ", a") #'rata-agent-antigravity-approve-plan
      (kbd ", ,") #'rata-agent-antigravity-approve-plan
      (kbd ", d") #'rata-agent-antigravity-decline-plan
      (kbd ", k") #'rata-agent-antigravity-decline-plan)))

(defun rata-agent-shell-antigravity-p (&optional buffer)
  "Return non-nil if BUFFER is an Antigravity `agent-shell'.
Defaults to `current-buffer'."
  (let ((buf (or buffer (current-buffer))))
    (and (buffer-live-p buf)
         (with-current-buffer buf
           (and (derived-mode-p 'agent-shell-mode)
                (bound-and-true-p agent-shell--state)
                (eq (map-nested-elt agent-shell--state '(:agent-config :identifier))
                    'antigravity))))))

(defun rata-agent-antigravity-session-id (&optional buffer)
  "Return the Antigravity session ID string for BUFFER (or current buffer)."
  (let ((buf (or buffer (current-buffer))))
    (when (buffer-live-p buf)
      (with-current-buffer buf
        (when (bound-and-true-p agent-shell--state)
          (map-nested-elt agent-shell--state '(:session :id)))))))

(defun rata-agent-antigravity-live-shells ()
  "Return a list of live Antigravity shell buffers."
  (if (fboundp 'agent-shell-buffers)
      (seq-filter #'rata-agent-shell-antigravity-p (agent-shell-buffers))
    nil))

(defun rata-agent-antigravity-session-dir (session-id)
  "Find the directory on disk for SESSION-ID across candidate brain directories.
If the directory does not exist yet, returns the path under
`rata-agent-antigravity-brain-dir' (or the first directory in
`rata-agent-antigravity-brain-dirs')."
  (when (and session-id (stringp session-id) (not (string-empty-p session-id)))
    (let ((dirs (delete-dups (cons rata-agent-antigravity-brain-dir
                                  rata-agent-antigravity-brain-dirs))))
      (or (seq-some (lambda (base)
                      (let ((d (expand-file-name session-id base)))
                        (and (file-directory-p d) d)))
                    dirs)
          (expand-file-name session-id (or rata-agent-antigravity-brain-dir
                                           (car dirs)
                                           (expand-file-name "~/.gemini/antigravity-acp/brain")))))))

(defun rata-agent-antigravity-session-artifacts (session-id)
  "Return a list of artifact plists for SESSION-ID from brain directory.
Each entry is a plist with `:file', `:name', `:summary',
`:request-feedback', `:updated-at', and `:mtime'.
Entries are sorted descending by modification time (most recent first)."
  (when (and session-id (stringp session-id) (not (string-empty-p session-id)))
    (let ((dir (rata-agent-antigravity-session-dir session-id)))
      (when (and dir (file-directory-p dir))
        (let* ((files (directory-files dir t "\\.md$" t))
               (artifacts nil))
          (dolist (file files)
            (when (file-regular-p file)
              (let* ((name (file-name-nondirectory file))
                     (meta-file (concat file ".metadata.json"))
                     (meta (when (file-exists-p meta-file)
                             (ignore-errors
                               (with-temp-buffer
                                 (insert-file-contents meta-file)
                                 (json-parse-string (buffer-string) :object-type 'alist)))))
                     (summary (and meta (cdr (assq 'summary meta))))
                     (request-feedback (and meta (eq (cdr (assq 'requestFeedback meta)) t)))
                     (updated-at (and meta (cdr (assq 'updatedAt meta))))
                     (attrs (file-attributes file))
                     (mtime (and attrs (file-attribute-modification-time attrs))))
                (push (list :file file
                            :name name
                            :summary summary
                            :request-feedback request-feedback
                            :updated-at updated-at
                            :mtime mtime)
                      artifacts))))
          (sort artifacts
                (lambda (a b)
                  (let ((ta (or (float-time (plist-get a :mtime)) 0.0))
                        (tb (or (float-time (plist-get b :mtime)) 0.0)))
                    (> ta tb)))))))))

(defun rata-agent-antigravity-session-plan (session-id)
  "Return the latest implementation plan artifact plist for SESSION-ID, or nil."
  (let ((artifacts (rata-agent-antigravity-session-artifacts session-id)))
    (or (seq-find (lambda (art) (plist-get art :request-feedback)) artifacts)
        (seq-find (lambda (art)
                    (string-match-p "plan" (plist-get art :name)))
                  artifacts)
        (car artifacts))))

(defun rata-agent-antigravity-recent-sessions (&optional limit)
  "Return a list of recent Antigravity session IDs with artifacts.
Returns at most LIMIT session IDs (default 10) searched across
`rata-agent-antigravity-brain-dirs'."
  (let ((max-sessions (or limit 10))
        (all-bases (delete-dups (cons rata-agent-antigravity-brain-dir
                                      rata-agent-antigravity-brain-dirs)))
        (sessions nil)
        (seen-ids (make-hash-table :test 'equal)))
    (dolist (base-dir all-bases)
      (when (file-directory-p base-dir)
        (let ((dirs (directory-files base-dir t "^[a-f0-9-]\\{36\\}$" t)))
          (dolist (d dirs)
            (when (file-directory-p d)
              (let ((id (file-name-nondirectory d)))
                (unless (gethash id seen-ids)
                  (when-let* ((md-files (directory-files d nil "\\.md$" t)))
                    (puthash id t seen-ids)
                    (let* ((attrs (file-attributes d))
                           (mtime (and attrs (file-attribute-modification-time attrs))))
                      (push (list :session-id id
                                  :dir d
                                  :mtime mtime
                                  :artifacts md-files)
                            sessions))))))))))
    (setq sessions (sort sessions
                         (lambda (a b)
                           (let ((ta (or (float-time (plist-get a :mtime)) 0.0))
                                 (tb (or (float-time (plist-get b :mtime)) 0.0)))
                             (> ta tb)))))
    (seq-take sessions max-sessions)))

(defun rata-agent-antigravity-choose-artifact (artifacts &optional query)
  "Select an artifact from ARTIFACTS plist list, optionally matching QUERY.
Returns the file path string, or nil if cancelled."
  (unless artifacts
    (user-error "No artifacts available to select"))
  (let* ((clean-q (and query (string-trim query)))
         (filtered (if (and clean-q (not (string-empty-p clean-q)))
                       (seq-filter
                        (lambda (art)
                          (let ((name (plist-get art :name))
                                (summary (or (plist-get art :summary) "")))
                            (or (string-match-p (regexp-quote clean-q) name)
                                (string-match-p (regexp-quote clean-q) summary))))
                        artifacts)
                     artifacts)))
    (cond
     ((= (length filtered) 1)
      (plist-get (car filtered) :file))
     ((null filtered)
      (message "No artifacts matched '%s', showing all artifacts" clean-q)
      (rata-agent-antigravity-choose-artifact artifacts nil))
     (t
      (let* ((candidates (mapcar (lambda (art)
                                   (cons (plist-get art :name) (plist-get art :file)))
                                 filtered))
             (metadata-table (make-hash-table :test 'equal)))
        (dolist (art filtered)
          (puthash (plist-get art :name) art metadata-table))
        (let* ((table (lambda (string pred action)
                        (if (eq action 'metadata)
                            `(metadata
                              (annotation-function
                               . ,(lambda (candidate)
                                    (when-let* ((art (gethash candidate metadata-table)))
                                      (let* ((summary (plist-get art :summary))
                                             (mtime (plist-get art :mtime))
                                             (time-str (if mtime
                                                           (format-time-string "%Y-%m-%d %H:%M" mtime)
                                                         "")))
                                        (if summary
                                            (format "  [%s] %s" time-str summary)
                                          (format "  [%s]" time-str)))))))
                          (complete-with-action action (mapcar #'car candidates) string pred))))
               (chosen-name (completing-read "Choose artifact: " table nil t)))
          (cdr (assoc chosen-name candidates))))))))

(defun rata-agent-antigravity--real-window-p (window)
  "Return non-nil if WINDOW is a regular (non-side, non-minibuffer) window."
  (and (window-live-p window)
       (not (window-minibuffer-p window))
       (not (window-parameter window 'window-side))
       (not (window-dedicated-p window))
       (not (string-prefix-p "*Agents*" (buffer-name (window-buffer window))))))

(defun rata-agent-antigravity--display-artifact-window (buf &optional shell-buffer)
  "Display artifact buffer BUF in an appropriate window and select it.
If BUF is already visible in a live window, select that window.
If the window for SHELL-BUFFER (or the selected window) is the only open
regular window in the layout (excluding side windows such as *Agents*),
split that window to the right and display BUF in the new window.
Otherwise, display BUF in an existing other regular window without creating
a new split."
  (let* ((existing-win (get-buffer-window buf))
         (shell-win (or (and shell-buffer (get-buffer-window shell-buffer))
                        (selected-window)))
         (all-real (seq-filter #'rata-agent-antigravity--real-window-p
                               (window-list nil 'nomini)))
         (other-real (seq-remove (lambda (w) (eq w shell-win)) all-real)))
    (cond
     ;; 1. Already visible in a live window: just select it
     ((and existing-win (window-live-p existing-win))
      (select-window existing-win))
     ;; 2. Another regular window is open: display in that window
     (other-real
      (let* ((mru (get-mru-window nil nil t))
             (target-win (if (and mru (member mru other-real))
                             mru
                           (car other-real))))
        (set-window-buffer target-win buf)
        (select-window target-win)))
     ;; 3. Shell window is the only open regular window: split to the right
     (t
      (let ((new-win (condition-case nil
                         (split-window shell-win nil 'right)
                       (error (split-window-sensibly shell-win)))))
        (if new-win
            (progn
              (set-window-buffer new-win buf)
              (select-window new-win))
          (pop-to-buffer buf)))))))

(defun rata-agent-antigravity-open-artifact-file (file &optional shell-buffer)
  "Open artifact FILE in an Emacs window.
When FILE represents an implementation plan, activates
`rata-agent-antigravity-artifact-mode' and associates it with SHELL-BUFFER.
Returns the opened buffer."
  (unless (and file (file-exists-p file))
    (user-error "Artifact file not found: %s" file))
  (let ((buf (find-file-noselect file)))
    (rata-agent-antigravity--display-artifact-window buf shell-buffer)
    (with-current-buffer buf
      (setq-local rata-agent-antigravity-artifact-shell-buffer shell-buffer)
      (let* ((name (file-name-nondirectory file))
             (is-plan (or (string-match-p "plan" name)
                          (let ((meta-file (concat file ".metadata.json")))
                            (and (file-exists-p meta-file)
                                 (ignore-errors
                                   (with-temp-buffer
                                     (insert-file-contents meta-file)
                                     (eq (cdr (assq 'requestFeedback
                                                    (json-parse-string (buffer-string) :object-type 'alist)))
                                         t))))))))
        (when is-plan
          (rata-agent-antigravity-artifact-mode 1))))
    (message "[Antigravity] Opened artifact: %s" (file-name-nondirectory file))
    buf))

;;;###autoload
(defun rata-agent-antigravity-open-artifact (&optional query session-id-or-buffer)
  "Open an Antigravity artifact in a buffer, optionally matching QUERY.
SESSION-ID-OR-BUFFER specifies the target session ID string or shell buffer;
when omitted, resolves from the current buffer, live Antigravity shells,
or recent sessions."
  (interactive)
  (let* ((target-buffer (cond
                         ((bufferp session-id-or-buffer) session-id-or-buffer)
                         ((rata-agent-shell-antigravity-p) (current-buffer))
                         (t nil)))
         (session-id (cond
                      ((stringp session-id-or-buffer) session-id-or-buffer)
                      (target-buffer (rata-agent-antigravity-session-id target-buffer))
                      (t
                       (let ((live-shells (rata-agent-antigravity-live-shells)))
                         (cond
                          ((= (length live-shells) 1)
                           (setq target-buffer (car live-shells))
                           (rata-agent-antigravity-session-id target-buffer))
                          ((> (length live-shells) 1)
                           (let* ((names (mapcar #'buffer-name live-shells))
                                  (chosen (completing-read "Select Antigravity shell: " names nil t)))
                             (setq target-buffer (get-buffer chosen))
                             (rata-agent-antigravity-session-id target-buffer)))
                          (t
                           (let ((recent (rata-agent-antigravity-recent-sessions 15)))
                             (unless recent
                               (user-error "No Antigravity sessions found in %s" rata-agent-antigravity-brain-dir))
                             (let* ((choices (mapcar
                                              (lambda (s)
                                                (let* ((sid (plist-get s :session-id))
                                                       (mtime (plist-get s :mtime))
                                                       (arts (plist-get s :artifacts))
                                                       (tstr (if mtime (format-time-string "%Y-%m-%d %H:%M" mtime) ""))
                                                       (summary (format "%s [%s] (%d artifacts: %s)"
                                                                        sid tstr (length arts)
                                                                        (string-join arts ", "))))
                                                  (cons summary sid)))
                                              recent))
                                    (selection (completing-read "Select past Antigravity session: " choices nil t)))
                               (cdr (assoc selection choices)))))))))))
    (unless session-id
      (user-error "Could not resolve an Antigravity session ID"))
    (let ((artifacts (rata-agent-antigravity-session-artifacts session-id)))
      (unless artifacts
        (user-error "No artifacts found for Antigravity session %s" session-id))
      (let ((chosen (rata-agent-antigravity-choose-artifact artifacts query)))
        (when chosen
          (rata-agent-antigravity-open-artifact-file chosen target-buffer))))))

(defun rata-agent-antigravity--shell-busy-p (&optional buffer)
  "Return non-nil if BUFFER is an active shell that is currently busy.
BUFFER defaults to the current buffer."
  (let ((buf (or buffer (current-buffer))))
    (and (buffer-live-p buf)
         (with-current-buffer buf
           (or (bound-and-true-p shell-maker--busy)
               (and (fboundp 'shell-maker-busy)
                    (ignore-errors (shell-maker-busy))))))))

;;;###autoload
(defun rata-agent-antigravity-approve-plan (&optional plan-file shell-buffer)
  "Approve PLAN-FILE in SHELL-BUFFER and submit approval to the agent.
When called interactively:
- In an artifact buffer: approves the current buffer's plan file.
- In an Antigravity shell or elsewhere: finds the session's latest plan.
Submits `[Approved] <plan_name>.md' into the shell and brings it to focus."
  (interactive)
  (let* ((target-file (or plan-file
                          (and rata-agent-antigravity-artifact-shell-buffer
                               buffer-file-name)
                          (and (derived-mode-p 'markdown-mode)
                               buffer-file-name)))
         (target-shell (or shell-buffer
                           rata-agent-antigravity-artifact-shell-buffer
                           (and (rata-agent-shell-antigravity-p) (current-buffer))
                           (car (rata-agent-antigravity-live-shells)))))
    (unless (and target-shell (buffer-live-p target-shell))
      (user-error "No active Antigravity shell buffer found to send approval to"))
    (let* ((session-id (rata-agent-antigravity-session-id target-shell))
           (resolved-file (or target-file
                              (when-let* ((p (rata-agent-antigravity-session-plan session-id)))
                                (plist-get p :file)))))
      (unless (and resolved-file (file-exists-p resolved-file))
        (user-error "No implementation plan file found to approve"))
      (let* ((plan-name (file-name-nondirectory resolved-file))
             (payload (format "[Approved] %s\n" plan-name)))
        (with-current-buffer target-shell
          (if (rata-agent-antigravity--shell-busy-p target-shell)
              (if (fboundp 'agent-shell--prompt-queue-enqueue)
                  (progn
                    (agent-shell--prompt-queue-enqueue :prompt payload)
                    (pop-to-buffer target-shell)
                    (message "[Antigravity] Shell is busy; queued plan approval: %s" plan-name))
                (user-error "Antigravity shell is busy; try again once agent finishes"))
            (agent-shell--insert-to-shell-buffer
             :shell-buffer target-shell
             :text payload
             :submit t)
            (pop-to-buffer target-shell)
            (message "[Antigravity] Approved plan: %s" plan-name)))))))

;;;###autoload
(defun rata-agent-antigravity-decline-plan (&optional reason plan-file shell-buffer)
  "Decline PLAN-FILE in SHELL-BUFFER with optional REASON and submit to agent.
When called interactively:
- In an artifact buffer: declines the current buffer's plan file.
- In an Antigravity shell or elsewhere: finds the session's latest plan.
Prompts for an optional reason/feedback string in the minibuffer.
Submits `[Declined] <plan_name>.md: <reason>' into the shell."
  (interactive
   (list (read-string "Decline reason (optional feedback for agent): ")))
  (let* ((target-file (or plan-file
                          (and rata-agent-antigravity-artifact-shell-buffer
                               buffer-file-name)
                          (and (derived-mode-p 'markdown-mode)
                               buffer-file-name)))
         (target-shell (or shell-buffer
                           rata-agent-antigravity-artifact-shell-buffer
                           (and (rata-agent-shell-antigravity-p) (current-buffer))
                           (car (rata-agent-antigravity-live-shells)))))
    (unless (and target-shell (buffer-live-p target-shell))
      (user-error "No active Antigravity shell buffer found to send decline to"))
    (let* ((session-id (rata-agent-antigravity-session-id target-shell))
           (resolved-file (or target-file
                              (when-let* ((p (rata-agent-antigravity-session-plan session-id)))
                                (plist-get p :file)))))
      (unless (and resolved-file (file-exists-p resolved-file))
        (user-error "No implementation plan file found to decline"))
      (let* ((plan-name (file-name-nondirectory resolved-file))
             (clean-reason (and reason (string-trim reason)))
             (payload (if (and clean-reason (not (string-empty-p clean-reason)))
                          (format "[Declined] %s: %s\n" plan-name clean-reason)
                        (format "[Declined] %s: Please revise the plan.\n" plan-name))))
        (with-current-buffer target-shell
          (if (rata-agent-antigravity--shell-busy-p target-shell)
              (if (fboundp 'agent-shell--prompt-queue-enqueue)
                  (progn
                    (agent-shell--prompt-queue-enqueue :prompt payload)
                    (pop-to-buffer target-shell)
                    (message "[Antigravity] Shell is busy; queued plan decline: %s" plan-name))
                (user-error "Antigravity shell is busy; try again once agent finishes"))
            (agent-shell--insert-to-shell-buffer
             :shell-buffer target-shell
             :text payload
             :submit t)
            (pop-to-buffer target-shell)
            (message "[Antigravity] Declined plan: %s" plan-name)))))))

;;; Shell Command Interceptors

(defun rata-agent-antigravity--handle-artifact-command (command shell-buffer)
  "Handle `/artifact' COMMAND executed in SHELL-BUFFER."
  (let* ((trimmed (string-trim command))
         (query (and (string-match "^/artifact\\(?:[ \t]+\\(.*\\)\\)?$" trimmed)
                     (match-string 1 trimmed)))
         (clean-query (and query (not (string-empty-p (string-trim query)))
                           (string-trim query)))
         (session-id (rata-agent-antigravity-session-id shell-buffer)))
    (with-current-buffer shell-buffer
      (if (not session-id)
          (progn
            (shell-maker-write-output :config shell-maker--config
                                      :output "No active Antigravity session.\n")
            (shell-maker-finish-output :config shell-maker--config :success t))
        (let ((artifacts (rata-agent-antigravity-session-artifacts session-id)))
          (if (null artifacts)
              (progn
                (shell-maker-write-output :config shell-maker--config
                                          :output "No artifacts found for this session.\n")
                (shell-maker-finish-output :config shell-maker--config :success t))
            (condition-case nil
                (let ((chosen (rata-agent-antigravity-choose-artifact artifacts clean-query)))
                  (if chosen
                      (progn
                        (shell-maker-write-output
                         :config shell-maker--config
                         :output (format "Opened artifact: %s\n" (file-name-nondirectory chosen)))
                        (shell-maker-finish-output :config shell-maker--config :success t)
                        (rata-agent-antigravity-open-artifact-file chosen shell-buffer))
                    (shell-maker-write-output :config shell-maker--config
                                              :output "No artifact selected.\n")
                    (shell-maker-finish-output :config shell-maker--config :success t)))
              (quit
               (shell-maker-write-output :config shell-maker--config
                                         :output "Artifact selection cancelled.\n")
               (shell-maker-finish-output :config shell-maker--config :success t)))))))))

(defun rata-agent-antigravity--handle-approve-command (command shell-buffer)
  "Handle `/approve' COMMAND executed in SHELL-BUFFER."
  (let* ((trimmed (string-trim command))
         (query (and (string-match "^/approve\\(?:[ \t]+\\(.*\\)\\)?$" trimmed)
                     (match-string 1 trimmed)))
         (clean-query (and query (not (string-empty-p (string-trim query)))
                           (string-trim query)))
         (session-id (rata-agent-antigravity-session-id shell-buffer)))
    (with-current-buffer shell-buffer
      (if (not session-id)
          (progn
            (shell-maker-write-output :config shell-maker--config
                                      :output "No active Antigravity session.\n")
            (shell-maker-finish-output :config shell-maker--config :success t))
        (let ((plan (if clean-query
                        (let ((matching (seq-filter
                                         (lambda (a)
                                           (string-match-p (regexp-quote clean-query)
                                                           (plist-get a :name)))
                                         (rata-agent-antigravity-session-artifacts session-id))))
                          (or (car matching) (rata-agent-antigravity-session-plan session-id)))
                      (rata-agent-antigravity-session-plan session-id))))
          (if (not plan)
              (progn
                (shell-maker-write-output :config shell-maker--config
                                          :output "No implementation plan found to approve in this session.\n")
                (shell-maker-finish-output :config shell-maker--config :success t))
            (let ((plan-name (plist-get plan :name)))
              (shell-maker-write-output :config shell-maker--config
                                        :output (format "Approving plan: %s\n" plan-name))
              (shell-maker-finish-output :config shell-maker--config :success t)
              (agent-shell--insert-to-shell-buffer
               :shell-buffer shell-buffer
               :text (format "[Approved] %s\n" plan-name)
               :submit t))))))))

(defun rata-agent-antigravity--handle-decline-command (command shell-buffer)
  "Handle `/decline' COMMAND executed in SHELL-BUFFER."
  (let* ((trimmed (string-trim command))
         (reason (and (string-match "^/decline\\(?:[ \t]+\\(.*\\)\\)?$" trimmed)
                      (match-string 1 trimmed)))
         (clean-reason (and reason (not (string-empty-p (string-trim reason)))
                            (string-trim reason)))
         (session-id (rata-agent-antigravity-session-id shell-buffer)))
    (with-current-buffer shell-buffer
      (if (not session-id)
          (progn
            (shell-maker-write-output :config shell-maker--config
                                      :output "No active Antigravity session.\n")
            (shell-maker-finish-output :config shell-maker--config :success t))
        (let ((plan (rata-agent-antigravity-session-plan session-id)))
          (if (not plan)
              (progn
                (shell-maker-write-output :config shell-maker--config
                                          :output "No implementation plan found to decline in this session.\n")
                (shell-maker-finish-output :config shell-maker--config :success t))
            (let* ((plan-name (plist-get plan :name))
                   (payload (if clean-reason
                                (format "[Declined] %s: %s\n" plan-name clean-reason)
                              (format "[Declined] %s: Please revise the plan.\n" plan-name))))
              (shell-maker-write-output :config shell-maker--config
                                        :output (format "Declining plan: %s\n" plan-name))
              (shell-maker-finish-output :config shell-maker--config :success t)
              (agent-shell--insert-to-shell-buffer
               :shell-buffer shell-buffer
               :text payload
               :submit t))))))))

(defun rata-agent-antigravity-session-meta (&optional base)
  "Return session `_meta' alist for Antigravity, merged over BASE.
Injects `systemPrompt.append' under the `antigravity' namespace so that
`agy_acp_server' configures the model with artifact creation instructions."
  (let* ((ag (copy-alist (alist-get 'antigravity base)))
         (sp (copy-alist (alist-get 'systemPrompt ag)))
         (existing-append (alist-get 'append sp))
         (new-append (if (and existing-append (not (string-empty-p existing-append)))
                         (concat existing-append "\n\n" rata-agent-antigravity-system-prompt)
                       rata-agent-antigravity-system-prompt)))
    (setf (alist-get 'append sp) new-append)
    (setf (alist-get 'systemPrompt ag) sp)
    (cons (cons 'antigravity ag)
          (seq-remove (lambda (item) (eq (car item) 'antigravity)) base))))

(defun rata-agent-antigravity--agent-config-advice (orig-fun &rest args)
  "Attach `:session-meta' with artifact system prompt to Antigravity agent config."
  (let ((config (apply orig-fun args)))
    (when (listp config)
      (let ((current-meta (map-elt config :session-meta)))
        (map-put! config :session-meta
                  (rata-agent-antigravity-session-meta current-meta))))
    config))

(defun rata-agent-antigravity-expand-plan-command (command shell-buffer)
  "Expand a `/plan' COMMAND in SHELL-BUFFER into a structured plan prompt.
Injects target session artifact path and requirements so that the Antigravity
agent creates an implementation plan artifact rather than writing plain text."
  (let* ((trimmed (string-trim command))
         (query (if (string-match "^/plan\\(?:[ \t]+\\(.*\\)\\)?$" trimmed)
                    (match-string 1 trimmed)
                  ""))
         (clean-query (if (and query (not (string-empty-p (string-trim query))))
                          (string-trim query)
                        "Implementation plan"))
         (session-id (rata-agent-antigravity-session-id shell-buffer))
         (session-dir (if session-id
                          (rata-agent-antigravity-session-dir session-id)
                        (expand-file-name "default" rata-agent-antigravity-brain-dir)))
         (slug (downcase (replace-regexp-in-string "[^a-zA-Z0-9]+" "-" clean-query)))
         (slug-trimmed (string-trim slug "-+" "-+"))
         (slug-short (substring slug-trimmed 0 (min (length slug-trimmed) 35)))
         (slug-clean (if (string-empty-p slug-short) "plan" slug-short))
         (plan-file (expand-file-name (format "%s.md" slug-clean) session-dir)))
    (when session-dir
      (ignore-errors (make-directory session-dir t)))
    (format "<PLAN>\nThe user is requesting that you think and plan carefully before executing the upcoming task.\nCarefully research the codebase and architectural guidelines, then create a detailed implementation plan artifact.\n\n# Planning Mode Artifacts Requirements:\n- Write the implementation plan artifact as a markdown (.md) file to:\n  Path: %s\n- Write companion metadata file alongside it:\n  Path: %s.metadata.json\n  Content: {\"summary\": \"<concise 2-line summary of plan>\", \"requestFeedback\": true, \"userFacing\": true}\n- The user will review the plan directly in Emacs via `/artifact` or `, A` (note: capital 'A'), and can approve via `C-c C-c` / `, a` or decline via `C-c C-k` / `, d` in the artifact buffer, or via `/approve` / `/decline` in the shell.\n- DO NOT dump the full plan in the chat. Briefly summarize your findings in chat and point to the artifact file.\n- Await user approval before executing any modifications.\n</PLAN>\n\n<USER_REQUEST>\n%s\n</USER_REQUEST>"
            plan-file plan-file clean-query)))

;;; Advices for agent-shell

(defun rata-agent-artifacts--advice-handle (orig-fun &rest args)
  "Advice on `agent-shell--handle' to handle artifact, approve, and plan."
  (let* ((command (plist-get args :command))
         (shell-buffer (or (plist-get args :shell-buffer) (current-buffer))))
    (if (and command
             (stringp command)
             (rata-agent-shell-antigravity-p shell-buffer))
        (let ((trimmed (string-trim command)))
          (cond
           ((string-match-p "^/artifact\\(?:[ \t].*\\)?$" trimmed)
            (rata-agent-antigravity--handle-artifact-command command shell-buffer))
           ((string-match-p "^/approve\\(?:[ \t].*\\)?$" trimmed)
            (rata-agent-antigravity--handle-approve-command command shell-buffer))
           ((string-match-p "^/decline\\(?:[ \t].*\\)?$" trimmed)
            (rata-agent-antigravity--handle-decline-command command shell-buffer))
           ((string-match-p "^/plan\\(?:[ \t].*\\)?$" trimmed)
            (let* ((expanded (rata-agent-antigravity-expand-plan-command command shell-buffer))
                   (new-args (copy-sequence args)))
              (plist-put new-args :command expanded)
              (apply orig-fun new-args)))
           (t
            (apply orig-fun args))))
      (apply orig-fun args))))

(defun rata-agent-artifacts--advice-submit (orig-fun &rest args)
  "Intercept artifact slash commands in `agent-shell-submit' when busy."
  (if (and (derived-mode-p 'agent-shell-mode)
           (rata-agent-shell-antigravity-p)
           (bound-and-true-p shell-maker--busy))
      (let ((input (string-trim (buffer-substring-no-properties
                                 (comint-line-beginning-position)
                                 (point-max)))))
        (cond
         ((string-match "^/artifact\\(?:[ \t]+\\(.*\\)\\)?$" input)
          (let ((query (match-string 1 input)))
            (delete-region (comint-line-beginning-position) (point-max))
            (when (and (boundp 'comint-input-ring) (ring-p comint-input-ring))
              (ring-insert comint-input-ring input))
            (rata-agent-antigravity-open-artifact query (current-buffer))))
         ((string-match "^/approve\\(?:[ \t]+\\(.*\\)\\)?$" input)
          (delete-region (comint-line-beginning-position) (point-max))
          (when (and (boundp 'comint-input-ring) (ring-p comint-input-ring))
            (ring-insert comint-input-ring input))
          (rata-agent-antigravity-approve-plan nil (current-buffer)))
         ((string-match "^/decline\\(?:[ \t]+\\(.*\\)\\)?$" input)
          (let ((reason (match-string 1 input)))
            (delete-region (comint-line-beginning-position) (point-max))
            (when (and (boundp 'comint-input-ring) (ring-p comint-input-ring))
              (ring-insert comint-input-ring input))
            (rata-agent-antigravity-decline-plan reason nil (current-buffer))))
         (t
          (apply orig-fun args))))
    (apply orig-fun args)))

(defun rata-agent-artifacts--advice-on-notification (orig-fun &rest args)
  "Inject artifact commands into `available_commands_update' notification."
  (let* ((state (plist-get args :state))
         (buf (and state (map-elt state :buffer)))
         (acp-notification (plist-get args :acp-notification)))
    (if (and buf
             (rata-agent-shell-antigravity-p buf)
             (equal (map-nested-elt acp-notification '(params update sessionUpdate))
                    "available_commands_update"))
        (let* ((params (map-elt acp-notification 'params))
               (update (map-elt params 'update))
               (raw-cmds (map-elt update 'availableCommands))
               (cmd-list (append raw-cmds nil))
               (has-artifact (seq-some (lambda (c) (equal (map-elt c 'name) "artifact")) cmd-list))
               (has-approve (seq-some (lambda (c) (equal (map-elt c 'name) "approve")) cmd-list))
               (has-decline (seq-some (lambda (c) (equal (map-elt c 'name) "decline")) cmd-list))
               (has-plan (seq-some (lambda (c) (equal (map-elt c 'name) "plan")) cmd-list))
               (new-list (copy-sequence cmd-list)))
          (unless has-artifact
            (setq new-list (cons '((name . "artifact")
                                   (description . "Open session artifact in an Emacs buffer"))
                                 new-list)))
          (unless has-approve
            (setq new-list (cons '((name . "approve")
                                   (description . "Approve current implementation plan and proceed"))
                                 new-list)))
          (unless has-decline
            (setq new-list (cons '((name . "decline")
                                   (description . "Decline current implementation plan with optional feedback"))
                                 new-list)))
          (unless has-plan
            (setq new-list (cons '((name . "plan")
                                   (description . "Plan carefully and generate an implementation plan artifact"))
                                 new-list)))
          (let* ((updated-cmds (if (vectorp raw-cmds) (vconcat new-list) new-list))
                 (new-update (cons (cons 'availableCommands updated-cmds)
                                   (assoc-delete-all 'availableCommands (copy-alist update))))
                 (new-params (cons (cons 'update new-update)
                                   (assoc-delete-all 'update (copy-alist params))))
                 (new-notif (cons (cons 'params new-params)
                                  (assoc-delete-all 'params (copy-alist acp-notification))))
                 (new-args (plist-put (copy-sequence args) :acp-notification new-notif)))
            (apply orig-fun new-args)))
      (apply orig-fun args))))

(defun rata-agent-artifacts--advice-command-completion (orig-fun &rest args)
  "Ensure artifact commands are included in completion candidates."
  (when-let* ((source (or (and (boundp 'agent-shell-completion--shell-buffer)
                               (buffer-live-p agent-shell-completion--shell-buffer)
                               agent-shell-completion--shell-buffer)
                          (and (fboundp 'agent-shell--shell-buffer)
                               (agent-shell--shell-buffer :no-error t :no-create t))
                          (current-buffer)))
              ((rata-agent-shell-antigravity-p source))
              (state (buffer-local-value 'agent-shell--state source)))
    (let* ((cmds (map-elt state :available-commands))
           (cmd-list (append cmds nil))
           (has-artifact (seq-some (lambda (c) (equal (map-elt c 'name) "artifact")) cmd-list))
           (has-approve (seq-some (lambda (c) (equal (map-elt c 'name) "approve")) cmd-list))
           (has-decline (seq-some (lambda (c) (equal (map-elt c 'name) "decline")) cmd-list))
           (has-plan (seq-some (lambda (c) (equal (map-elt c 'name) "plan")) cmd-list)))
      (when (or (not has-artifact) (not has-approve) (not has-decline) (not has-plan))
        (let ((updated (copy-sequence cmd-list)))
          (unless has-artifact
            (push '((name . "artifact")
                    (description . "Open session artifact in an Emacs buffer"))
                  updated))
          (unless has-approve
            (push '((name . "approve")
                    (description . "Approve current implementation plan and proceed"))
                  updated))
          (unless has-decline
            (push '((name . "decline")
                    (description . "Decline current implementation plan with optional feedback"))
                  updated))
          (unless has-plan
            (push '((name . "plan")
                    (description . "Plan carefully and generate an implementation plan artifact"))
                  updated))
          (map-put! state :available-commands (if (vectorp cmds) (vconcat updated) updated))))))
  (apply orig-fun args))

(with-eval-after-load 'agent-shell
  (advice-add 'agent-shell--handle :around #'rata-agent-artifacts--advice-handle)
  (advice-add 'agent-shell-submit :around #'rata-agent-artifacts--advice-submit)
  (advice-add 'agent-shell--on-notification :around #'rata-agent-artifacts--advice-on-notification)
  (advice-add 'agent-shell--command-completion-at-point :around #'rata-agent-artifacts--advice-command-completion))

(with-eval-after-load 'agent-shell-antigravity
  (advice-add 'agent-shell-antigravity-make-agent-config
              :around #'rata-agent-antigravity--agent-config-advice))
(when (featurep 'agent-shell-antigravity)
  (advice-add 'agent-shell-antigravity-make-agent-config
              :around #'rata-agent-antigravity--agent-config-advice))

